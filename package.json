{
  "name": "telegram-channel-queue-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "coverage:gate": "bun scripts/check-coverage.ts",
    "test:deploy": "bash test/deploy/release.test.sh && bash test/deploy/backup.test.sh",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "grammy": "1.38.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "typescript": "5.9.3"
  }
}
