BOT_TOKEN=
ADMIN_USER_ID=
QUEUE_CHANNEL_ID=
TARGET_CHANNEL_ID=
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=info

# Private admin interface: classic (default), widget (normal Telegram endpoint),
# or beta-test (Telegram test environment with a disposable bot and separate data).
# ADMIN_WIDGETS=classic

# Optional absolute path to a secret file containing a single Cookie header value.
# Used only for Instagram extraction; never sent to media CDN hosts.
# INSTAGRAM_COOKIE_FILE=/absolute/path/instagram-cookie.txt

# Deployment-only variables. Leave both unset for local development.
# RELEASE_SHA=development
# RUNTIME_STATUS_PATH=/run/shitpost-cms/ready.json
